{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "anchor_text": {
      "type": "string"
    },
    "from": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "page",
        "citation"
      ]
    },
    "position": {
      "minimum": 1,
      "type": "integer"
    },
    "to": {
      "type": "string"
    },
    "unresolved": {
      "const": true
    }
  },
  "required": [
    "from",
    "to",
    "kind",
    "anchor_text",
    "position"
  ],
  "title": "Sourcebook link record",
  "type": "object"
}
