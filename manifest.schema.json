{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "format": {
            "const": 3
          }
        }
      },
      "then": {
        "properties": {
          "pages": {
            "items": {
              "required": [
                "reference_status",
                "assessment"
              ]
            }
          }
        }
      }
    }
  ],
  "properties": {
    "approvals": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "type": "integer"
        },
        "hash": {
          "type": "string"
        },
        "pages": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "approved_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "public_id": {
                "type": "string"
              }
            },
            "required": [
              "public_id",
              "approved_at"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "hash",
        "count",
        "pages"
      ],
      "type": "object"
    },
    "approvals_hash": {
      "type": "string"
    },
    "component_versions": {
      "additionalProperties": false,
      "properties": {
        "atlas_assemble": {
          "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$",
          "type": "string"
        },
        "exporter": {
          "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$",
          "type": "string"
        },
        "release_build": {
          "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "atlas_assemble",
        "exporter",
        "release_build"
      ],
      "type": "object"
    },
    "corrections": {
      "additionalProperties": false,
      "properties": {
        "patch_root": {
          "type": "string"
        },
        "policy": {
          "type": "string"
        }
      },
      "required": [
        "policy",
        "patch_root"
      ],
      "type": "object"
    },
    "counts": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "minimum": 0,
          "type": "integer"
        },
        "excluded": {
          "minimum": 0,
          "type": "integer"
        },
        "passed": {
          "minimum": 0,
          "type": "integer"
        },
        "published": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "candidates",
        "passed",
        "published",
        "excluded"
      ],
      "type": "object"
    },
    "edition": {
      "type": "string"
    },
    "exclusions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "public_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "public_id",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "format": {
      "enum": [
        2,
        3
      ]
    },
    "package": {
      "additionalProperties": false,
      "properties": {
        "archive": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "type": "object"
        },
        "checksums": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "type": "object"
        },
        "chunks": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "type": "object"
        },
        "links": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "type": "object"
        },
        "objects": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "type": "object"
        }
      },
      "required": [
        "objects",
        "links",
        "chunks",
        "checksums",
        "archive"
      ],
      "type": "object"
    },
    "pages": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "approved_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "assessment": {
            "additionalProperties": false,
            "properties": {
              "assessed": {
                "format": "date",
                "type": "string"
              },
              "basis": {
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "change_record": {
                "type": "string"
              },
              "conclusion": {
                "minLength": 1,
                "type": "string"
              },
              "confidence": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "corroboration": {
                "enum": [
                  "independent",
                  "partial",
                  "single-source",
                  "contradicted"
                ]
              },
              "counterargument": {
                "type": "string"
              },
              "response": {
                "type": "string"
              },
              "source_tier": {
                "enum": [
                  "primary-multiple",
                  "primary-single",
                  "secondary",
                  "journalistic",
                  "speculative"
                ]
              },
              "wep": {
                "enum": [
                  "ALMOST CERTAINLY",
                  "VERY LIKELY",
                  "LIKELY",
                  "EVEN CHANCE",
                  "UNLIKELY",
                  "VERY UNLIKELY",
                  "REMOTE",
                  "INSUFFICIENT BASIS"
                ]
              },
              "would_revise": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "conclusion",
              "wep",
              "confidence",
              "source_tier",
              "corroboration",
              "basis",
              "would_revise",
              "counterargument",
              "response",
              "assessed",
              "change_record"
            ],
            "type": [
              "object",
              "null"
            ]
          },
          "banner": {
            "minLength": 1,
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "provenance": {
            "type": "string"
          },
          "public_id": {
            "type": "string"
          },
          "reference_status": {
            "enum": [
              null,
              "reference",
              "assessed"
            ]
          },
          "rights": {
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "source_content_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "topics": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "public_id",
          "title",
          "path",
          "url",
          "sha256",
          "source_content_hash",
          "rights",
          "provenance",
          "topics",
          "approved_at"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "source_cutoff": {
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "git_head": {
          "type": "string"
        },
        "record_id": {
          "type": "string"
        }
      },
      "required": [
        "fingerprint",
        "record_id",
        "git_head"
      ],
      "type": "object"
    }
  },
  "required": [
    "edition",
    "format",
    "approvals_hash",
    "approvals",
    "source_cutoff",
    "component_versions",
    "counts",
    "exclusions",
    "corrections",
    "package",
    "pages"
  ],
  "title": "Sourcebook edition manifest formats 2 and 3",
  "type": "object"
}
